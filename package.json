{
  "name": "accessready",
  "version": "0.2.0",
  "description": "WCAG 2.2 AA audit for a whole site. Runs axe-core, then uses every page the way a keyboard user does, in real Chrome, to catch what rule engines miss.",
  "type": "module",
  "bin": {
    "accessready": "bin/accessready.mjs"
  },
  "exports": "./src/index.mjs",
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "ada",
    "axe-core",
    "playwright",
    "keyboard",
    "focus",
    "audit",
    "cli",
    "ci"
  ],
  "author": "Michael Sewell (https://msewell.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeSewell/accessready.git"
  },
  "homepage": "https://github.com/MikeSewell/accessready#readme",
  "bugs": {
    "url": "https://github.com/MikeSewell/accessready/issues"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "franc-min": "^6.2.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  }
}
